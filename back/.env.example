# Copier ce fichier vers .env et adapter les valeurs.

# Connexion MariaDB/MySQL
DATABASE_URL="mysql://root:<mot_de_passe>@localhost:3310/sportify"

# Port d'écoute du serveur NestJS
PORT=3000

# Secrets JWT (à changer en production)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ALGO="HS256"
JWT_ACCESS_EXP="1d"
JWT_REFRESH_EXP="7d"
JWT_REFRESH_MAX_AGE=7

# Rounds bcrypt pour le hash des mots de passe
SALT=10
